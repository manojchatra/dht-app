# ── Desert Hot Tubs App — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.

# Port the Node app listens on (nginx proxies from 443 → this port)
PORT=3001

NODE_ENV=production

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=replace-this-with-a-long-random-string

# Path to your Google service account JSON key file (same one used for passdown app)
GOOGLE_KEY_FILE=/home/DHT/passdown-proxy/service-account-key.json

# Google Drive file ID of your Inventory.xlsx
# Get it from the share URL: drive.google.com/file/d/FILE_ID_HERE/view
INVENTORY_FILE_ID=your_inventory_file_id_here
