# nginx.ssl.conf_proxy
#
# INSTRUCTIONS:
# 1. Upload this file to your VPS at this exact path:
#    /home/DHT/conf/web/app.deserthottubsaz.com/nginx.ssl.conf_proxy
#
# 2. Then reload nginx:
#    Hestia CP → Server → Nginx → Restart
#    (or: sudo service nginx reload)
#
# NOTE: X-Real-IP / X-Forwarded-For / X-Forwarded-Proto must be set on every
# location block below — the Node app trusts this proxy (app.set('trust
# proxy', 1)) to determine the real client IP (used for login rate-limiting)
# and whether the original request was HTTPS (used for secure session cookies).
# This file only takes effect once it's re-uploaded to the VPS and nginx is reloaded.

location = /acknowledgement {
    proxy_pass         http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header   Upgrade    $http_upgrade;
    proxy_set_header   Connection 'upgrade';
    proxy_set_header   Host       $host;
    proxy_set_header   X-Real-IP  $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
}

location ~ ^/(delivery|acknowledgement)/[0-9]+$ {
    proxy_pass         http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header   Upgrade    $http_upgrade;
    proxy_set_header   Connection 'upgrade';
    proxy_set_header   Host       $host;
    proxy_set_header   X-Real-IP  $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
}

location / {
    proxy_pass         http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header   Upgrade    $http_upgrade;
    proxy_set_header   Connection 'upgrade';
    proxy_set_header   Host       $host;
    proxy_set_header   X-Real-IP  $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
    client_max_body_size 20M;
}

location /uploads/ {
    alias /home/DHT/dht-app/uploads/;
    expires 30d;
}
